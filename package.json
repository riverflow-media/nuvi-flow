{
  "name": "personal-media-addon",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Self-hosted Stremio-compatible personal media server for Windows, Docker, CasaOS, and ZimaOS",
  "author": "Personal Media Addon contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "npm run build && electron-forge start",
    "package:windows": "npm run build && electron-forge package --platform=win32 --arch=x64",
    "make:windows": "npm run build && electron-forge make --platform=win32 --arch=x64"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "better-sqlite3": "^12.4.1",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "ffprobe-static": "^3.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "mime-types": "^3.0.1",
    "p-limit": "^7.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.10.1",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "^43.1.1",
    "happy-dom": "^20.11.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
