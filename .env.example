# Public URL used by Stremio/Nuvio to reach this server.
BASE_URL=http://localhost:60500

# Required: choose a unique password and two independent random secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
STREAM_SECRET=replace-with-a-different-32-character-secret

# Optional. Leave blank for automatic Cinemeta metadata with a local fallback.
TMDB_API_KEY=

# Absolute host paths. Docker mounts both libraries read-only.
MOVIES_PATH=/absolute/path/to/Movies
TV_PATH=/absolute/path/to/TV Shows

PORT=60500
SCAN_INTERVAL_MINUTES=30
MINIMUM_FILE_SIZE_MB=50
SCAN_CONCURRENCY=2
WATCH_MEDIA=true
SCAN_ON_STARTUP=true

# Optional Silo playback integration. These can also be saved in the admin dashboard.
SILO_ENABLED=false
SILO_URL=http://silo:8080
SILO_API_KEY=
SILO_PROFILE_ID=
SILO_TRANSCODE_QUALITY=auto
SHOW_DIRECT_PLAY=true

# Optional private Stremio-compatible fallback (AIOStreams supported).
FALLBACK_ADDON_ENABLED=false
FALLBACK_ADDON_MANIFEST_URL=
FALLBACK_ADDON_TIMEOUT_MS=5000
FALLBACK_ADDON_USE_FOR_MISSING=true
FALLBACK_ADDON_BEFORE_TRANSCODE=true
FALLBACK_ADDON_MAX_ATTEMPTS=10
FALLBACK_ADDON_STARTUP_BUDGET_MS=15000
FALLBACK_ADDON_MAX_RESOLUTION=auto
FALLBACK_ADDON_ALLOW_RESOLUTION_DOWNGRADE=true
FALLBACK_ADDON_NETWORK_ADAPTATION=true
FALLBACK_ADDON_NETWORK_HEADROOM_PERCENT=35
FALLBACK_ADDON_NETWORK_MEMORY_MINUTES=45
# 0 means no first-play network ceiling.
FALLBACK_ADDON_COLD_START_MBPS=0
