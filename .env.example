# Public URL used by Stremio/Nuvio to reach this server.
BASE_URL=http://localhost:60500

# Required: choose a unique password and two independent random secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
STREAM_SECRET=replace-with-a-different-32-character-secret

# Optional. Leave blank for automatic Cinemeta metadata with a local fallback.
TMDB_API_KEY=

# Absolute host paths. Docker mounts both libraries read-only.
MOVIES_PATH=/absolute/path/to/Movies
TV_PATH=/absolute/path/to/TV Shows

PORT=60500
SCAN_INTERVAL_MINUTES=30
MINIMUM_FILE_SIZE_MB=50
SCAN_CONCURRENCY=2
WATCH_MEDIA=true
SCAN_ON_STARTUP=true

